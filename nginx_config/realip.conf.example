# Restore the original client IP behind upstream proxies (Traefik, docker networks).
#
# Mounted as /etc/nginx/conf.d/00-realip.conf, so the directives apply in the
# http context and are inherited by every server block, including the local
# (gitignored) nginx_config/nginx.conf.
#
# Effect: $remote_addr becomes the real client IP, so X-Real-IP and
# $proxy_add_x_forwarded_for sent to Django carry the source address.

set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 127.0.0.1/32;
real_ip_header X-Forwarded-For;
real_ip_recursive on;
